# Hardened static hosting for the showcase site. Self-contained: the site is built
# inside this Containerfile, so `podman build` (quadlets, manage-quadlet build, CI)
# needs nothing on the host but podman itself.
#   podman build -f deploy/Containerfile -t localhost/showcase_static .
# deploy/sample-run.sh does that plus starting the container on 127.0.0.1:9712.
#
# A dist/ in the build context is ignored (.containerignore); src/ is the source of truth,
# and the same tree always produces the same image regardless of what a host happened to
# build last.
#
# What this server can and cannot do, measured with the same binary (busybox 1.37.0,
# pulled from the image this file is based on) against the built dist/:
#   CAN  serve /sead -> 302 -> /sead/ -> the page: possible because build.mjs writes
#        <route>/index.html with root-absolute refs next to the flat <route>.html.
#        Without those, "minimum container" meant 404 on every canonical URL.
#   CAN  index.html at /, Range requests (video seeking), dotfile hiding, 1 process, no shell.
#   CANNOT  send any response header it does not invent: no CSP, no Cache-Control, no
#        nosniff, no redirects other than its own directory 302s, no custom 404 page
#        (404.html in the tree is never used), no gzip, no keep-alive (Connection: close).
#   CANNOT  be told the MIME type for .webp/.woff2/.mp4/.ico (the build stage generates the
#        first of those): they are not in its built-in table
#        and httpd.conf has no working mapping syntax (a bare "*.ext:value" line means
#        "run value as a CGI handler" and every request for that type then 404s; E:/A:
#        forms are silently ignored). Those files go out with no Content-Type header,
#        which browsers tolerate -- but a front proxy adding X-Content-Type-Options:
#        nosniff would then forbid the sniff. Measured in Chromium 156 and it does not
#        block: webp renders and the font loads with no Content-Type at all, because
#        nosniff's hard refusals are scripts and stylesheets and this image serves neither
#        (no JS; .css is typed correctly). The typed proxy is still worth its eight lines -
#        for clients that trust the header instead of sniffing, and so the bytes say what
#        they are - but it is correctness, not an emergency. deploy/proxy-showcase.conf.
# So: the security policy and canonical URLs in nginx.conf do not exist here — the front
# proxy supplies them (deploy/proxy-showcase.conf), or serve dist/ with nginx.conf directly.
# See README.

# ---------- build stage: runs the repo's own build.mjs, with cwebp for webp ----------
FROM node:24-bookworm-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends webp \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY build.mjs ./
COPY src ./src
RUN node build.mjs

# ---------- runtime: busybox (static musl build) + the built site, nothing else ----------
FROM busybox:1.37-musl AS bin

FROM scratch

COPY --from=bin /bin/busybox /bin/busybox
COPY --from=build /src/dist/ /www/
COPY deploy/passwd /etc/passwd
COPY deploy/inetd.conf /etc/inetd.conf

# No USER line: in rootless podman the container's root is the host service
# user, which owns the socket directory. With --cap-drop=all there is no
# setuid, so runtime user and inetd.conf's user field must match (root).

# inetd reads /etc/inetd.conf by default; bind is done once at startup, so the
# unix socket in the mounted volume must be writable by the runtime user.
# Override with: --entrypoint /bin/busybox <image> httpd -f -p 8080 -h /www
ENTRYPOINT ["/bin/busybox", "inetd", "-f", "-e"]
